 // Ok returns true if err only pertains to EOF (read was successful).
 func Ok(err error) bool {
 	// zstd.ErrMagicMismatch is expected at EOF because .rec files have extra non-compressed data.
 	return err == nil || errors.Is(err, io.EOF) || errors.Is(err, zstd.ErrMagicMismatch)
 }
+
+// RoundError is a round file of a match folder that could not be read.
+type RoundError struct {
+	Index int    // position of the file in the folder's file-name order, from 0
+	Path  string // path of the .rec file
+	Err   error  // what NewReader, Read or opening the file returned
+}
+
+func (e *RoundError) Error() string {
+	return fmt.Sprintf("dissect: round file %s: %v", filepath.Base(e.Path), e.Err)
+}
+
+func (e *RoundError) Unwrap() error { return e.Err }
+
+// IncompleteMatchError is returned by MatchReader.Read when one or more round files
+// could not be read. The rounds that were read are still available; the skipped ones
+// are left out of Data, PlayerStats and WriteExcel and listed in Data as skippedRounds.
+//
+// It does not unwrap to its round errors, so Ok reports false for it even when every
+// round failed with io.EOF: a caller that only checks Ok fails cleanly instead of
+// using a match with missing rounds.
+type IncompleteMatchError struct {
+	Skipped []*RoundError // in file order
+	Total   int           // number of round files in the folder
+}
+
+func (e *IncompleteMatchError) Error() string {
+	return fmt.Sprintf("dissect: %d of %d round files could not be read (first: %v)", len(e.Skipped), e.Total, e.Skipped[0])
+}
